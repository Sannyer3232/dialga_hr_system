<div class="container-fluid">
    <h2 class="mb-4 text-primary">Métricas de Precisão da IA</h2>
    <div class="row mb-4">
        <div class="col-md-4">
            <div class="dialga-card p-4 text-center">
                <h6 class="text-secondary">MAE (Erro Médio Absoluto)</h6>
                <h3 class="fw-bold text-info">1.45 hrs</h3>
            </div>
        </div>
        <div class="col-md-4">
            <div class="dialga-card p-4 text-center">
                <h6 class="text-secondary">RMSE (Raiz do Erro Quadrático)</h6>
                <h3 class="fw-bold text-info">2.12 hrs</h3>
            </div>
        </div>
        <div class="col-md-4">
            <div class="dialga-card p-4 text-center">
                <h6 class="text-secondary">R² Score (Aderência)</h6>
                <h3 class="fw-bold text-info">0.89</h3>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-12">
            <div class="dialga-card p-4">
                <h5 class="mb-3">Gráfico de Dispersão (Real vs. Predito)</h5>
                <canvas id="scatterChart" height="400"></canvas>
            </div>
        </div>
    </div>
</div>

<script src="/js/metrics.js"></script>
