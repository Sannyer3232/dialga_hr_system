<div class="sidebar d-flex flex-column flex-shrink-0 p-3 text-white bg-dark-dialga" style="width: 280px; min-height: 100vh;">
    <a href="/" class="d-flex flex-column align-items-center mb-4 mt-3 text-white text-decoration-none text-center">
        <div class="bg-white p-3 rounded-circle mb-3 d-flex align-items-center justify-content-center" style="width: 120px; height: 120px; box-shadow: 0 0 25px rgba(255,255,255,0.4); border: 3px solid rgba(0,212,255,0.6);">
            <img src="/img/logo.png" alt="Dialga Logo" style="max-width: 95%; max-height: 95%;">
        </div>
        <span class="fs-3 fw-bold text-info">Dialga RH</span>
    </a>
    <hr>
    <ul class="nav nav-pills flex-column mb-auto">
        <li class="nav-item">
            <a href="/dashboard" class="nav-link text-white {{#if activeDashboard}}active-dialga{{/if}}" aria-current="page">
                <i class="bi bi-speedometer2 me-2"></i> Dashboard
            </a>
        </li>
        <li>
            <a href="/simulacao" class="nav-link text-white {{#if activeSimulacao}}active-dialga{{/if}}">
                <i class="bi bi-magic me-2"></i> Time Machine
            </a>
        </li>
        <li>
            <a href="/metrics" class="nav-link text-white {{#if activeMetrics}}active-dialga{{/if}}">
                <i class="bi bi-bar-chart-line me-2"></i> IA Metrics
            </a>
        </li>
        <li>
            <a href="/bulk" class="nav-link text-white {{#if activeBulk}}active-dialga{{/if}}">
                <i class="bi bi-file-earmark-arrow-up me-2"></i> Bulk Intelligence
            </a>
        </li>
    </ul>
    <hr>
    <div class="dropdown">
        <a href="#" class="d-flex align-items-center text-white text-decoration-none dropdown-toggle" id="dropdownUser1" data-bs-toggle="dropdown" aria-expanded="false">
            <div class="avatar-initials rounded-circle border border-info d-flex align-items-center justify-content-center bg-info text-white fw-bold me-2" style="width: 32px; height: 32px; font-size: 0.8rem;">
                {{getInitials user.full_name}}
            </div>
            <strong>{{user.full_name}}</strong>
        </a>
        <ul class="dropdown-menu dropdown-menu-dark text-small shadow" aria-labelledby="dropdownUser1">
            <li><a class="dropdown-item" href="#">Settings</a></li>
            <li><a class="dropdown-item" href="#">Profile</a></li>
            <li><hr class="dropdown-divider"></li>
            <li><a class="dropdown-item" href="/logout">Sign out</a></li>
        </ul>
    </div>
</div>
