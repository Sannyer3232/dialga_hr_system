<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <title>Login | Dialga HR System</title>
    <link rel="stylesheet" href="/bootstrap/css/bootstrap.min.css">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-dialga-login d-flex align-items-center justify-content-center" style="height: 100vh;">
    <div class="dialga-card p-5 shadow-lg" style="width: 400px; border-top: 5px solid #00D4FF;">
        <div class="text-center mb-4">
            <h2 class="text-primary fw-bold">Dialga Recursos Humanos</h2>
            <p class="text-secondary small">Domine o tempo da sua equipe</p>
        </div>
        
        {{#if error}}
        <div class="alert alert-danger small py-2">{{error}}</div>
        {{/if}}

        <form action="/login" method="POST">
            <div class="mb-3">
                <label class="form-label text-secondary small">Usuário</label>
                <input type="text" name="username" id="username" class="form-control bg-transparent border-secondary" required>
            </div>
            <div class="mb-4">
                <label class="form-label text-secondary small">Senha</label>
                <input type="password" name="password" id="password" class="form-control bg-transparent border-secondary" required>
            </div>
            <button type="submit" class="btn btn-info w-100 fw-bold">Entrar</button>
        </form>
    </div>
</body>
</html>
