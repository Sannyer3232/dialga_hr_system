<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <title>Login | Dialga HR System</title>
    <link rel="icon" type="image/x-icon" href="/img/favicon.ico">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/bootstrap/css/bootstrap.min.css">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-dialga-login d-flex align-items-center justify-content-center" style="height: 100vh;">
    <div id="global-loader" class="loader-overlay" style="display: none;">
        <div class="loader-content">
            <div class="spinner-border text-info" role="status" style="width: 3rem; height: 3rem;"></div>
            <h5 class="mt-3 text-info">Processando Inteligência Dialga...</h5>
        </div>
    </div>

    <div class="dialga-card p-5 shadow-lg" style="width: 400px; border-top: 5px solid #00D4FF;">
        <div class="text-center mb-4">
            <div class="mx-auto mb-3 d-flex align-items-center justify-content-center" style="width: 180px; height: 180px;">
                <img src="/img/logo.png" alt="Dialga Logo" style="max-width: 100%; max-height: 100%; filter: drop-shadow(0 0 10px rgba(0, 212, 255, 0.4));">
            </div>
            <h2 class="text-primary fw-bold">Dialga Recursos Humanos</h2>

            <p class="text-secondary small">Domine o tempo da sua equipe</p>
        </div>
        
        {{#if error}}
        <div class="alert alert-danger small py-2">{{error}}</div>
        {{/if}}

        <form action="/login" method="POST">
            <div class="mb-3">
                <label class="form-label text-secondary small">Usuário</label>
                <input type="text" name="username" id="username" class="form-control bg-transparent border-secondary" required>
            </div>
            <div class="mb-4">
                <label class="form-label text-secondary small">Senha</label>
                <input type="password" name="password" id="password" class="form-control bg-transparent border-secondary" required>
            </div>
            <button type="submit" class="btn btn-info w-100 fw-bold">Entrar</button>
        </form>
    </div>

    <script>
        document.querySelector('form').addEventListener('submit', function() {
            document.getElementById('global-loader').style.display = 'flex';
        });
    </script>
</body>
</html>
