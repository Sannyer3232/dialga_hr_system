<div class="container-fluid">
    <h2 class="mb-4 text-primary">Projeção do Tempo (Simulador What-If)</h2>
    <div class="row">
        <div class="col-md-6">
            <div class="dialga-card p-4">
                <form id="simulacaoForm">
                    <div class="mb-3">
                        <label class="form-label text-secondary">Colaborador</label>
                        <select class="form-select bg-transparent border-secondary" id="colabSelect">
                            <option value="1">Desenvolvedor Backend</option>
                            <option value="2">Analista de Qualidade</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-secondary">Ajuste de Carga de Trabalho (%)</label>
                        <input type="range" class="form-range" id="workload" min="50" max="150" value="100">
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-secondary">Mês da Projeção</label>
                        <input type="month" class="form-control bg-transparent border-secondary">
                    </div>
                    <button type="button" class="btn btn-outline-info w-100" onclick="executarPrevisao()">
                        Invocar Previsão
                    </button>
                </form>
            </div>
        </div>
        
        <div class="col-md-6 d-flex align-items-center justify-content-center">
            <div class="text-center">
                <h5 class="text-secondary mb-4">O Olho de Dialga Vê:</h5>
                <div class="dialga-eye-badge fs-1 py-4 px-5" id="resultadoPrevisao">
                    -- hrs
                </div>
                <p class="mt-3 text-muted">Ausência projetada com base nos parâmetros temporais.</p>
            </div>
        </div>
    </div>
</div>

<script src="/js/simulacao.js">
   
</script>