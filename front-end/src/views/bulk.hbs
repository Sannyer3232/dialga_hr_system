<div class="container-fluid">
    <h2 class="mb-4 text-primary">Bulk Intelligence: Processamento de Arquivos</h2>
    
    <div class="row mb-5">
        <div class="col-md-12">
            <div class="dialga-card p-5 text-center border-dashed">
                <i class="bi bi-cloud-arrow-up text-info" style="font-size: 4rem;"></i>
                <h4 class="mt-3">Envie sua Base de Dados</h4>
                <p class="text-secondary">Arraste ou selecione seu arquivo CSV ou Excel com os dados de entrada da IA.</p>
                
                <div class="mt-4 d-flex justify-content-center">
                    <div class="input-group" style="max-width: 500px;">
                        <input type="file" class="form-control bg-transparent text-dark border-info" id="fileInput" accept=".csv, .xlsx, .xls">
                        <button class="btn btn-info fw-bold" type="button" onclick="processarArquivo()">
                            <i class="bi bi-cpu"></i> Processar com IA
                        </button>
                    </div>
                </div>
                <div class="mt-3">
                    <small class="text-secondary">
                        <i class="bi bi-info-circle"></i> O arquivo deve conter colunas como: Reason, Month, Day, Seasons, Distance, ServiceTime, Age, BMI, etc.
                    </small>
                </div>
            </div>
        </div>
    </div>

    <!-- Resultados (Escondidos inicialmente) -->
    <div id="resultsContainer" style="display: none;">
        <h4 class="text-primary mb-4"><i class="bi bi-clipboard-data"></i> Relatório de Processamento</h4>
        
        <div class="row mb-4">
            <div class="col-md-4">
                <div class="dialga-card p-4 text-center">
                    <h6 class="text-secondary">Linhas Processadas</h6>
                    <h3 class="fw-bold text-info" id="resTotalRows">0</h3>
                </div>
            </div>
            <div class="col-md-4">
                <div class="dialga-card p-4 text-center">
                    <h6 class="text-secondary">Média de Absenteísmo</h6>
                    <h3 class="fw-bold text-info" id="resAvgHours">0 hrs</h3>
                </div>
            </div>
            <div class="col-md-4">
                <div class="dialga-card p-4 text-center">
                    <h6 class="text-secondary">Tempo de Processamento</h6>
                    <h3 class="fw-bold text-info" id="resProcTime">0s</h3>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-12">
                <div class="dialga-card p-4">
                    <h5 class="mb-3 text-success"><i class="bi bi-award"></i> Ranking: Colaboradores mais Assíduos (Menor Previsão)</h5>
                    <div class="table-responsive">
                        <table class="table table-hover table-transparent text-dark">
                            <thead>
                                <tr class="text-secondary">
                                    <th>#</th>
                                    <th>Colaborador</th>
                                    <th>Previsão de Faltas (Horas)</th>
                                    <th>Status Sugerido</th>
                                </tr>
                            </thead>
                            <tbody id="rankingBody">
                                <!-- Preenchido via JS -->
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
.border-dashed {
    border: 2px dashed rgba(0, 212, 255, 0.4) !important;
}
.table-transparent {
    --bs-table-bg: transparent;
    --bs-table-color: inherit;
}
</style>

<script src="/js/bulk.js"></script>
